{
  "name": "billing-bitrix",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "NODE_OPTIONS=--max-old-space-size=1536 nuxt dev --host",
    "predev": "env NODE_OPTIONS=--max-old-space-size=1536 NUXT_PUBLIC_DEV=true nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "updateDB": "npx prisma db pull && npx prisma generate"
  },
  "dependencies": {
