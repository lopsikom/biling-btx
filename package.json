    "@nuxtjs/google-fonts": "^3.2.0",
    "@pinia/nuxt": "^0.11.3",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "axios": "^1.13.4",
    "ioredis": "^5.10.1",
    "nuxt": "^4.2.1",
    "pg": "^8.18.0",
    "pinia": "^3.0.4",
    "qs": "^6.15.1",
    "reka-ui": "^2.7.0",
    "vue": "^3.5.26",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.10.0",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "@types/qs": "^6.15.0",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "^14.1.0",
    "eslint": "^9.39.1",
    "prisma": "^7.3.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.5"
  }
